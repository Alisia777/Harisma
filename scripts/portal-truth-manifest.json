{
  "schema": "portal-truth-manifest-v1",
  "version": "2026-07-24",
  "description": "Canonical data lineage, daily intake and publish contracts for every portal view.",
  "policy": {
    "timezone": "Europe/Moscow",
    "protectedScopeExcluded": true,
    "moneyToleranceAbsolute": 1000,
    "moneyToleranceRelative": 0.001,
    "dateToleranceDays": 1,
    "ownerCoverageWarn": 0.9,
    "ownerCoverageBlock": 0.65,
    "dashboardCardSoftLimit": 80,
    "dashboardCardHardLimit": 160,
    "dashboardDuplicateRatioBlock": 0.1,
    "mojibakeBlockCount": 5,
    "unmappedRevenueWarnRatio": 0.005,
    "unmappedRevenueBlockRatio": 0.02
  },
  "sources": [
    {
      "key": "company_plan",
      "file": "company_plan.json",
      "kind": "plan-master",
      "required": true,
      "freshness": "monthly",
      "datePaths": ["activeMonthKey", "generatedAt"],
      "repairStep": "company-plan-rebuild",
      "description": "Single source of truth for monthly plans and salary-contour channel totals."
    },
    {
      "key": "platform_fact",
      "file": "platform_trends.json",
      "kind": "fact-master",
      "required": true,
      "freshness": "daily",
      "datePaths": ["latestMarketplaceDate", "asOfDate", "generatedAt"],
      "repairStep": "marketplace-api",
      "description": "Daily marketplace fact by platform and date."
    },
    {
      "key": "retail_network_source_status",
      "file": "retail_network_source_status.json",
      "kind": "source-health",
      "required": false,
      "freshness": "daily",
      "datePaths": ["cutoffDate", "generatedAt"],
      "repairStep": "retail-network-daily-sync",
      "description": "Per-network freshness, source row counts and latest daily totals for ZYA, Letual, Megamarket and Samokat."
    },
    {
      "key": "sku_registry",
      "file": "skus.json",
      "kind": "dimension-master",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["generatedAt", "meta.generatedAt"],
      "repairStep": "google-sheet-build",
      "description": "Canonical SKU, article, lifecycle and owner dimension."
    },
    {
      "key": "dashboard_projection",
      "file": "dashboard.json",
      "kind": "projection",
      "required": true,
      "freshness": "daily",
      "datePaths": ["latestMarketplaceDate", "dataFreshness.asOfDate", "asOfDate", "generatedAt"],
      "repairStep": "google-sheet-build",
      "description": "Presentation projection only; it must reconcile to plan, fact and SKU masters."
    },
    {
      "key": "ads_fact",
      "file": "ads_summary.json",
      "kind": "fact-detail",
      "required": true,
      "freshness": "daily",
      "datePaths": ["window.to", "asOfDate", "generatedAt"],
      "repairStep": "ads-sync"
    },
    {
      "key": "warehouse_fact",
      "file": "warehouse_stock_overlay.json",
      "kind": "fact-detail",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["asOfDate", "generatedAt"],
      "repairStep": "warehouse-stock"
    },
    {
      "key": "logistics_fact",
      "file": "logistics.json",
      "kind": "fact-detail",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["latest_logistics_date", "latestLogisticsDate", "generatedAt", "meta.generatedAt"],
      "repairStep": "google-sheet-build"
    },
    {
      "key": "price_master",
      "file": "prices.json",
      "kind": "calculation-master",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["asOfDate", "generatedAt", "monthKey"],
      "repairStep": "smart-price"
    },
    {
      "key": "smart_price_overlay",
      "file": "smart_price_overlay.json",
      "kind": "calculation-detail",
      "required": true,
      "freshness": "daily",
      "datePaths": ["asOfDate", "generatedAt"],
      "repairStep": "smart-price"
    },
    {
      "key": "repricer",
      "file": "repricer.json",
      "kind": "projection",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["asOfDate", "generatedAt"],
      "repairStep": "smart-price"
    },
    {
      "key": "order_procurement",
      "file": "order_procurement.json",
      "kind": "calculation-master",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["asOfDate", "generatedAt"],
      "repairStep": "order-procurement"
    },
    {
      "key": "order_procurement_wb",
      "file": "order_procurement_wb.json",
      "kind": "calculation-detail",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["asOfDate", "generatedAt"],
      "repairStep": "order-procurement"
    },
    {
      "key": "order_procurement_ozon",
      "file": "order_procurement_ozon.json",
      "kind": "calculation-detail",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["asOfDate", "generatedAt"],
      "repairStep": "order-procurement"
    },
    {
      "key": "order_procurement_ym",
      "file": "order_procurement_ym.json",
      "kind": "calculation-detail",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["asOfDate", "generatedAt"],
      "repairStep": "order-procurement"
    },
    {
      "key": "oos_control",
      "file": "oos_control.json",
      "kind": "calculation-master",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["asOfDate", "generatedAt"],
      "repairStep": "oos-control"
    },
    {
      "key": "sku_matrix",
      "file": "sku_matrix.json",
      "kind": "mapping-master",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["generatedAt"],
      "repairStep": "sku-matrix"
    },
    {
      "key": "sku_aliases",
      "file": "sku_aliases.json",
      "kind": "mapping-master",
      "required": true,
      "freshness": "none",
      "datePaths": ["generatedAt"],
      "repairStep": "sku-alias-snapshots"
    },
    {
      "key": "sku_alias_ignore",
      "file": "sku_alias_ignore.json",
      "kind": "mapping-policy",
      "required": true,
      "freshness": "none",
      "datePaths": ["generatedAt"],
      "repairStep": "sku-alias-snapshots"
    },
    {
      "key": "sku_alias_audit",
      "file": "sku_alias_audit.json",
      "kind": "mapping-audit",
      "required": true,
      "freshness": "none",
      "datePaths": ["generatedAt"],
      "repairStep": "sku-alias-snapshots"
    },
    {
      "key": "owner_audit",
      "file": "wb_owner_distribution_audit.json",
      "kind": "mapping-audit",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["generatedAt"],
      "repairStep": "wb-owner-distribution"
    },
    {
      "key": "data_quality",
      "file": "portal_data_quality.json",
      "kind": "quality-gate",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["summary.maxDate", "maxDate", "generatedAt"],
      "repairStep": "data-quality"
    },
    {
      "key": "data_quarantine",
      "file": "portal_data_quarantine.json",
      "kind": "quality-gate",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["generatedAt"],
      "repairStep": "data-quality"
    },
    {
      "key": "product_leaderboard",
      "file": "product_leaderboard.json",
      "kind": "projection",
      "required": false,
      "freshness": "max-age-10d",
      "datePaths": ["asOfDate", "generatedAt", "sourceMtime"],
      "repairStep": "leaderboard-history"
    },
    {
      "key": "product_leaderboard_history",
      "file": "product_leaderboard_history.json",
      "kind": "history",
      "required": false,
      "freshness": "max-age-10d",
      "datePaths": ["generatedAt"],
      "repairStep": "leaderboard-history"
    },
    {
      "key": "wb_feedbacks",
      "file": "wb_feedbacks_summary.json",
      "kind": "fact-detail",
      "required": true,
      "freshness": "daily",
      "datePaths": ["window.to", "asOfDate", "generatedAt"],
      "repairStep": "wb-feedbacks"
    },
    {
      "key": "wb_sales_funnel",
      "file": "wb_sales_funnel_report.json",
      "kind": "projection",
      "required": true,
      "freshness": "daily",
      "datePaths": ["period.to", "generatedAt"],
      "repairStep": "wb-sales-funnel"
    },
    {
      "key": "iu_plan",
      "file": "iu_plan.json",
      "kind": "plan-master",
      "required": true,
      "freshness": "monthly",
      "datePaths": ["activeMonthKey", "months", "generatedAt"],
      "repairStep": "iu-plan-rebuild"
    },
    {
      "key": "iu_drr_summary",
      "file": "iu_drr_summary.json",
      "kind": "calculation-master",
      "required": true,
      "freshness": "daily",
      "datePaths": ["asOfDate", "window.to", "generatedAt"],
      "repairStep": "iu-drr-rebuild"
    },
    {
      "key": "control_auto_task_sources",
      "file": "control_auto_task_sources.json",
      "kind": "calculation-detail",
      "required": true,
      "freshness": "daily-build",
      "datePaths": ["generatedAt"],
      "repairStep": "control-auto-task-sources"
    },
    {
      "key": "wb_substitution_traffic",
      "file": "wb_substitution_traffic.json",
      "kind": "fact-detail",
      "required": false,
      "freshness": "max-age-45d",
      "datePaths": ["asOfDate", "source.sourceGeneratedAt", "generatedAt"],
      "repairStep": "wb-substitution-traffic"
    },
    {
      "key": "wb_substitution_traffic_history",
      "file": "wb_substitution_traffic_history.json",
      "kind": "history",
      "required": false,
      "freshness": "max-age-45d",
      "datePaths": ["asOfDate", "generatedAt"],
      "repairStep": "wb-substitution-traffic"
    },
    {
      "key": "loyalty_system",
      "file": "loyalty_system.json",
      "kind": "reference",
      "required": false,
      "freshness": "none",
      "datePaths": ["generatedAt"],
      "repairStep": "google-sheet-build"
    },
    {
      "key": "launches",
      "file": "launches.json",
      "kind": "operational-master",
      "required": false,
      "freshness": "none",
      "datePaths": ["generatedAt", "updatedAt"],
      "repairStep": "launches-rebuild"
    },
    {
      "key": "meetings",
      "file": "meetings.json",
      "kind": "operational-master",
      "required": false,
      "freshness": "none",
      "datePaths": ["generatedAt", "updatedAt"],
      "repairStep": "portal-operational-storage"
    },
    {
      "key": "documents",
      "file": "documents.json",
      "kind": "operational-master",
      "required": false,
      "freshness": "none",
      "datePaths": ["generatedAt", "updatedAt"],
      "repairStep": "portal-operational-storage"
    },
    {
      "key": "seed_comments",
      "file": "seed_comments.json",
      "kind": "operational-seed",
      "required": false,
      "freshness": "none",
      "datePaths": ["generatedAt", "updatedAt"],
      "repairStep": "portal-operational-storage"
    }
  ],
  "views": {
    "dashboard": {"sources": ["dashboard_projection", "platform_fact", "company_plan", "sku_registry", "ads_fact", "warehouse_fact"], "critical": true, "updateMode": "daily-batch"},
    "executive": {"sources": ["sku_registry", "owner_audit", "sku_matrix", "platform_fact", "company_plan", "data_quality"], "critical": true, "updateMode": "daily-batch"},
    "control": {"sources": ["sku_registry", "sku_matrix", "data_quality", "control_auto_task_sources", "seed_comments"], "critical": false, "updateMode": "hybrid"},
    "data-health": {"sources": ["data_quality", "data_quarantine", "sku_matrix", "owner_audit"], "critical": true, "updateMode": "daily-batch"},
    "sku-plan-fact": {"sources": ["company_plan", "platform_fact", "sku_registry", "sku_matrix", "sku_aliases", "sku_alias_ignore", "sku_alias_audit", "ads_fact", "warehouse_fact", "price_master", "smart_price_overlay", "data_quality"], "critical": true, "updateMode": "daily-batch"},
    "repricer": {"sources": ["repricer", "price_master", "smart_price_overlay", "sku_registry", "warehouse_fact", "data_quality"], "critical": true, "updateMode": "daily-batch"},
    "prices": {"sources": ["price_master", "smart_price_overlay", "sku_registry", "warehouse_fact", "data_quality"], "critical": true, "updateMode": "daily-batch"},
    "order": {"sources": ["order_procurement", "order_procurement_wb", "order_procurement_ozon", "order_procurement_ym", "warehouse_fact", "platform_fact", "sku_registry"], "critical": true, "updateMode": "daily-batch"},
    "oos-control": {"sources": ["oos_control", "warehouse_fact", "platform_fact", "sku_registry"], "critical": true, "updateMode": "daily-batch"},
    "ads-funnel": {"sources": ["ads_fact", "wb_sales_funnel", "platform_fact", "sku_registry"], "critical": true, "updateMode": "daily-batch"},
    "sku-contour": {"sources": ["sku_registry", "sku_matrix", "sku_aliases", "sku_alias_ignore", "sku_alias_audit", "owner_audit", "platform_fact", "data_quality"], "critical": true, "updateMode": "daily-batch"},
    "skus": {"sources": ["sku_registry", "sku_matrix", "sku_aliases", "sku_alias_ignore", "sku_alias_audit", "owner_audit"], "critical": true, "updateMode": "daily-batch"},
    "launches": {"sources": ["launches", "sku_registry", "warehouse_fact", "price_master", "data_quality"], "critical": false, "updateMode": "hybrid"},
    "wb-rating": {"sources": ["wb_feedbacks", "sku_registry"], "critical": false, "updateMode": "daily-batch"},
    "product-leaderboard": {"sources": ["product_leaderboard", "product_leaderboard_history", "wb_substitution_traffic", "wb_substitution_traffic_history", "ads_fact", "platform_fact", "sku_registry"], "critical": false, "updateMode": "daily-batch"},
    "iu-drr": {"sources": ["iu_plan", "iu_drr_summary", "ads_fact", "wb_feedbacks", "wb_substitution_traffic"], "critical": true, "updateMode": "daily-batch"},
    "meetings": {"sources": ["meetings"], "critical": false, "updateMode": "operational"},
    "documents": {"sources": ["documents"], "critical": false, "updateMode": "operational"},
    "designers": {"sources": [], "critical": false, "updateMode": "operational"}
  },
  "metricPassports": {
    "plan.marketplace.revenue": {"source": "company_plan", "formula": "months[month].revenue", "grain": "month"},
    "plan.marketplace.revenue.wb": {"source": "company_plan", "formula": "months[month].channels.wb.revenue", "grain": "month"},
    "plan.marketplace.revenue.ozon": {"source": "company_plan", "formula": "months[month].channels.ozon.revenue", "grain": "month"},
    "plan.marketplace.revenue.ya": {"source": "company_plan", "formula": "months[month].channels.ya.revenue", "grain": "month"},
    "fact.marketplace.revenue": {"source": "platform_fact", "formula": "sum(wb, ozon, ya) on one common cutoff date", "grain": "day/cumulative-month"},
    "owner.coverage": {"source": "sku_registry", "formula": "SKU with canonical owner / active SKU", "grain": "SKU"},
    "dashboard.cards": {"source": "dashboard_projection", "formula": "unique presentation cards; no repeated semantic signatures", "grain": "card"}
  }
}
